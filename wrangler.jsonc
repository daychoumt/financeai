// Firebase Web API key identifies the public project; GEMINI_API_KEY remains a Cloudflare secret.
{
  "name": "financeai",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "finance-ai-3e186",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "ALLOWED_ORIGINS": "https://daychoumt.github.io,http://localhost:8000",
    "FIREBASE_WEB_API_KEY": "AIzaSyDJBFrih9vXdhrQx7oQHRb6Mft7XoyOGlk"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_QUOTA",
        "class_name": "ChatQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatQuota"
      ]
    }
  ]
}
